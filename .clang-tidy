# Basic clang-tidy checks for the tutorial code: likely bugs, performance issues and a few
# low-noise modernizations. Checks that flag patterns the tutorial uses on purpose are disabled:
#   bugprone-branch-clone: empty #if branches for graphics APIs that aren't being built.
#   bugprone-exception-escape: main() and logging destructors that could in theory throw.
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling: strncpy/memcpy into
#     fixed-size OpenXR structure buffers.
#   performance-avoid-endl: std::endl is used throughout the tutorial's logging.
#   performance-no-int-to-ptr: OpenGL buffer offsets and D3D12 descriptor handles.
#
# Run with a compilation database, e.g. configure with -DCMAKE_EXPORT_COMPILE_COMMANDS=ON, then:
#   clang-tidy -p build Chapter2/main.cpp
Checks: >
  -*,
  bugprone-*,
  -bugprone-branch-clone,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-narrowing-conversions,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  misc-redundant-expression,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  -performance-avoid-endl,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  readability-container-size-empty,
  readability-misleading-indentation,
  readability-redundant-string-cstr
# Only report warnings from the tutorial's own headers in Common/ or a Chapter folder. This skips
# OpenXR (including copies fetched under Chapter*/app/.cxx), thirdparty, system headers and
# Microsoft's d3dx12.h in Chapter6_1_Multiview/Common. Add new tutorial headers to the list.
HeaderFilterRegex: '.*[/\\](Common|Chapter[^/\\]*)[/\\](DebugOutput|GraphicsAPI|HelperFunctions|OpenXR)[^/\\]*\.h$'
FormatStyle: file
